{
  "manifest_version": 3,
  "name": "PageGuide Gemini",
  "version": "1.0.0",
  "description": "Click a Gemini citation to jump to the already-open source tab and highlight the cited text, with no duplicate tabs.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "contentScript.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}